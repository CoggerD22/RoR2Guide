# dependencies
node_modules/
.pnpm-store/

# build output
dist/
dist-ssr/

# test / tooling artifacts
playwright-report/
test-results/
blob-report/
node_modules/.tmp/
*.tsbuildinfo

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# env & editor
.env
.env.*
!.env.example
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Decompiled game code — LOCAL ONLY, never commit (copyright). Verification uses it
# in place; the repo keeps only the derived facts + citations.
.decompiled/

# Extracted game asset data (copyright Gearbox) — produced by scripts/extract-bodies.py
.gamedata/

# ProcDumper build artifacts (the DLL is rebuilt from source; never commit it)
tools/**/bin/
tools/**/obj/
proc-dump.csv

# Personal Claude Code overrides (machine-specific permission posture).
# Never commit: this repo is public and settings.local.json can relax permissions.
.claude/settings.local.json

# scripts/mutation-sweep.mjs --ci renames these aside and restores them; if a run is killed
# mid-sweep they can be left behind, and they are Gearbox's data either way.
*.hidden-by-sweep/

# scratch for a research pass; never part of the site
.work/
